# Copy to .env and fill in. Never commit .env: provider keys stay on the server.

# --- storage and messaging
FOREX_DB_URL=sqlite:///data/forex.db
# PostgreSQL / TimescaleDB
# FOREX_DB_URL=postgresql://forex:forex@db:5432/forex
# needed when services run separately
# FOREX_REDIS_URL=redis://redis:6379/0

# Easiest: run `python -m forexapp.setup` (or start.bat / start.sh), which writes this file for you.

# --- data provider: yahoo (free, no key) | oanda | eodhd | tradermade | simulated (pick one and stick with it)
FOREX_PROVIDER=yahoo
# yahoo: seconds between price reads
# FOREX_POLL_SECONDS=5
FOREX_PAIRS=EURUSD,GBPUSD,USDJPY,XAUUSD
FOREX_PRICE_BASIS=bid
# OANDA_TOKEN=
# OANDA_ACCOUNT=
# OANDA_ENV=practice
# EODHD_API_KEY=
# TRADERMADE_API_KEY=

# --- simulated market (development / demo)
# 30 market minutes per real minute
# FOREX_SIM_SPEED=30
# 06:30 London on the latest weekday, or an ISO time
# FOREX_SIM_START=demo

# --- forecasting model
# kronos | bootstrap (statistical stand-in, not Kronos)
FOREX_MODEL_BACKEND=kronos
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
# Phase 6 fine-tuned predictor
# KRONOS_CHECKPOINT=models/checkpoints/<exp>/basemodel/best_model
# KRONOS_TOKENIZER_CHECKPOINT=models/checkpoints/<exp>/tokenizer/best_model
# KRONOS_DEVICE=cuda:0
FOREX_LOOKBACK=480
FOREX_HORIZON=24
FOREX_PATHS=30
FOREX_CHART_FORECASTS=true

# --- signal rules
FOREX_SESSIONS=london,newyork,tokyo
FOREX_SETUP_EXPIRY_MIN=90
# or_mid | or_far
FOREX_STOP_RULE=or_mid
FOREX_MIN_STOP_ATR=0.5
FOREX_MAX_RISK_ATR=3.0
FOREX_STOP_CHECK_BARS=6
FOREX_STOP_CHECK_PCT=10
FOREX_TP2_CAP_R=3.0
FOREX_MIN_CONFIDENCE=0.55
FOREX_SLIPPAGE_PIPS=0.2
FOREX_COMMISSION_PER_LOT=0
FOREX_TM_REPLAYS=2000

# --- Phase 7 extras: switch on one at a time, after a backtest
FOREX_REQUIRE_HTF=false
FOREX_VOLATILITY_FILTER=false
FOREX_REGIME_FILTER=false
FOREX_TM_SYNTHETIC=false
# Claude explanations; needs ANTHROPIC_API_KEY
FOREX_EXPLAIN=false
# FOREX_EXPLAIN_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# --- privacy and login
# With a password the app asks for it and listens on your network (phone on the same Wi-Fi, Tailscale).
# Without one, only this computer can open it.
# FOREX_PASSWORD=
# advanced: none | token | supabase
FOREX_AUTH_MODE=none
# FOREX_API_TOKEN=
# SUPABASE_JWT_SECRET=
# FOREX_CORS_ORIGINS=https://your-app.example.com
FOREX_PORT=8000

# --- alerts and news
# FOREX_ALERT_WEBHOOK=https://...
# FOREX_NTFY_TOPIC=my-private-fx-topic
FOREX_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# FOREX_CALENDAR_FILE=data/calendar.json
